{
  "name": "ideal",
  "private": true,
  "scripts": {
    "dev:admin": "npm --prefix apps/admin run dev",
    "dev:api": "npm --prefix services/api run start:dev",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:push": "npm --prefix services/api run db:push",
    "db:generate": "npm --prefix services/api run db:generate",
    "db:studio": "npm --prefix services/api run db:studio",
    "build:admin": "npm --prefix apps/admin run build",
    "build:api": "npm --prefix services/api run build",
    "lint:admin": "npm --prefix apps/admin run lint",
    "lint:api": "npm --prefix services/api run lint",
    "mobile:analyze": "cd apps/mobile && flutter analyze",
    "mobile:test": "cd apps/mobile && flutter test",
    "mobile:run": "cd apps/mobile && flutter run"
  },
  "dependencies": {
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1"
  }
}
