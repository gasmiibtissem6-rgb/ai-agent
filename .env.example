# ─────────────────────────────────────────────
# IDEAL API — environment configuration
# Copy this file to `.env` and fill in real values.
# NEVER commit real secrets. This file must contain placeholders only.
# ─────────────────────────────────────────────

# App
NODE_ENV=development          # development | production
API_PORT=3001

# ── Database (REQUIRED) ──────────────────────
# PostgreSQL connection string.
# Docker default:
#   postgresql://ideal:<password>@localhost:5434/ideal_dev?schema=public
# Supabase:
#   postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?schema=public
DATABASE_URL=

# ── Supabase (REQUIRED) ──────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase JWT secret (OPTIONAL) — enables offline HS256 token verification
# (no network round-trip per request). Leave empty to verify via Supabase API.
SUPABASE_JWT_SECRET=

# ── Auth (REQUIRED) ──────────────────────────
# Secret used to sign and verify API-issued JWTs. Use a long random value.
JWT_SECRET=

# ── CORS (REQUIRED) ──────────────────────────
# Comma-separated list of approved origins. No wildcard is allowed.
# Example (dev): http://localhost:3000,http://localhost:3001
ALLOWED_ORIGINS=

# ── Local admin login (OPTIONAL, development only) ──
# When both are set, enables an offline admin login for local dev.
# No default is provided; leave empty to disable local admin login.
LOCAL_ADMIN_EMAIL=
LOCAL_ADMIN_PASSWORD=

# ── Optional services ────────────────────────
FCM_SERVER_KEY=
OCR_API_KEY=
PAYMENT_PROVIDER=
PAYMENT_SECRET_KEY=
