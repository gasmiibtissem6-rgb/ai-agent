# App
NODE_ENV=development
API_PORT=3001

# Database
# Docker default:
DATABASE_URL="postgresql://ideal:ideal_dev_password@localhost:5434/ideal_dev?schema=public"

# Native local PostgreSQL example:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ideal_dev?schema=public"

# Supabase PostgreSQL example:
# DATABASE_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?schema=public"

# Supabase services are optional for local database-only API work.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Auth
JWT_SECRET=replace-with-a-local-development-secret
LOCAL_ADMIN_EMAIL=admin@ideal.local
LOCAL_ADMIN_PASSWORD=ChangeMe123!

# Optional services
FCM_SERVER_KEY=
OCR_API_KEY=
PAYMENT_PROVIDER=
PAYMENT_SECRET_KEY=
