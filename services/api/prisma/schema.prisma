generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
model Profile {
  id                  String           @id @default(uuid()) @db.Uuid
  authUserId          String           @unique @map("auth_user_id") @db.Uuid
  email               String           @unique
  displayName         String?          @map("display_name")
  username            String?          @unique
  avatarUrl           String?          @map("avatar_url")
  kycStatus           KycStatus        @default(NOT_STARTED) @map("kyc_status")
  isPublic            Boolean          @default(false) @map("is_public")
  isAdmin             Boolean          @default(false) @map("is_admin")
  adminRole           AdminRole?       @map("admin_role")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  archivedAt          DateTime?        @map("archived_at")
  adminActions        AdminAction[]    @relation("AdminActor")
  auditLogs           AuditLog[]       @relation("AuditActor")
  ownedCompanies      Company[]        @relation("CompanyOwner")
  companyMemberships  CompanyMember[]
  dealApprovals       DealApproval[]
  uploadedFiles       DealFile[]
  invitedDealParties  DealParty[]      @relation("PartyInviter")
  dealParties         DealParty[]      @relation("PartyProfile")
  createdDealVersions DealVersion[]    @relation("VersionCreator")
  createdDeals        Deal[]           @relation("DealCreator")
  createdInviteLinks  DealInviteLink[] @relation("InviteCreator")
  kycSubmissions      KycSubmission[]  @relation("KycOwner")
  reviewedSubmissions KycSubmission[]  @relation("KycReviewer")
  sentMessages        Message[]
  notifications       Notification[]
  reportsCreated      Report[]         @relation("ReportCreator")
  reportsReviewed     Report[]         @relation("ReportReviewer")
  subscriptions       Subscription[]
  trustCounter        TrustCounter?

  @@index([authUserId])
  @@index([email])
  @@index([kycStatus])
  @@map("profiles")
}

model Company {
  id             String          @id @default(uuid()) @db.Uuid
  ownerProfileId String          @map("owner_profile_id") @db.Uuid
  legalName      String          @map("legal_name")
  status         String          @default("active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  archivedAt     DateTime?       @map("archived_at")
  owner          Profile         @relation("CompanyOwner", fields: [ownerProfileId], references: [id])
  members        CompanyMember[]
  deals          Deal[]
  subscriptions  Subscription[]

  @@index([ownerProfileId])
  @@map("companies")
}

model CompanyMember {
  id        String            @id @default(uuid()) @db.Uuid
  companyId String            @map("company_id") @db.Uuid
  profileId String            @map("profile_id") @db.Uuid
  role      CompanyMemberRole
  status    String            @default("active")
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  company   Company           @relation(fields: [companyId], references: [id])
  profile   Profile           @relation(fields: [profileId], references: [id])

  @@unique([companyId, profileId])
  @@index([companyId])
  @@index([profileId])
  @@map("company_members")
}

model KycSubmission {
  id                  String     @id @default(uuid()) @db.Uuid
  profileId           String     @map("profile_id") @db.Uuid
  status              KycStatus  @default(SUBMITTED)
  documentType        String?    @map("document_type")
  front               String?
  back                String?
  selfie              String?
  personalInfo        Json?      @map("personal_info")
  providerReference   String?    @map("provider_reference")
  rejectionReason     String?    @map("rejection_reason")
  submittedAt         DateTime?  @map("submitted_at")
  reviewedAt          DateTime?  @map("reviewed_at")
  reviewedByProfileId String?    @map("reviewed_by_profile_id") @db.Uuid
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")
  files               DealFile[]
  profile             Profile    @relation("KycOwner", fields: [profileId], references: [id])
  reviewedBy          Profile?   @relation("KycReviewer", fields: [reviewedByProfileId], references: [id])

  @@index([profileId])
  @@index([status])
  @@map("kyc_submissions")
}

model TrustCounter {
  id              String   @id @default(uuid()) @db.Uuid
  profileId       String   @unique @map("profile_id") @db.Uuid
  successfulDeals Int      @default(0) @map("successful_deals")
  ongoingDeals    Int      @default(0) @map("ongoing_deals")
  breachedDeals   Int      @default(0) @map("breached_deals")
  updatedAt       DateTime @updatedAt @map("updated_at")
  profile         Profile  @relation(fields: [profileId], references: [id])

  @@map("trust_counters")
}

model Deal {
  id               String           @id @default(uuid()) @db.Uuid
  creatorProfileId String           @map("creator_profile_id") @db.Uuid
  companyId        String?          @map("company_id") @db.Uuid
  title            String
  description      String?
  dealType         String?          @map("deal_type")
  status           DealStatus       @default(DRAFT)
  currentVersionId String?          @map("current_version_id") @db.Uuid
  lockedVersionId  String?          @map("locked_version_id") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  archivedAt       DateTime?        @map("archived_at")
  cancelledAt      DateTime?        @map("cancelled_at")
  files            DealFile[]
  inviteLinks      DealInviteLink[]
  parties          DealParty[]
  versions         DealVersion[]
  company          Company?         @relation(fields: [companyId], references: [id])
  creator          Profile          @relation("DealCreator", fields: [creatorProfileId], references: [id])
  messages         Message[]

  @@index([creatorProfileId])
  @@index([companyId])
  @@index([status])
  @@map("deals")
}

model DealParty {
  id                 String         @id @default(uuid()) @db.Uuid
  dealId             String         @map("deal_id") @db.Uuid
  profileId          String?        @map("profile_id") @db.Uuid
  email              String
  role               String
  partyStatus        PartyStatus    @default(INVITED) @map("party_status")
  requiredApproval   Boolean        @default(true) @map("required_approval")
  invitedByProfileId String         @map("invited_by_profile_id") @db.Uuid
  acceptedAt         DateTime?      @map("accepted_at")
  declinedAt         DateTime?      @map("declined_at")
  revokedAt          DateTime?      @map("revoked_at")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  approvals          DealApproval[]
  deal               Deal           @relation(fields: [dealId], references: [id])
  invitedBy          Profile        @relation("PartyInviter", fields: [invitedByProfileId], references: [id])
  profile            Profile?       @relation("PartyProfile", fields: [profileId], references: [id])

  @@unique([dealId, email])
  @@index([dealId])
  @@index([profileId])
  @@index([email])
  @@map("deal_parties")
}

model DealVersion {
  id                 String         @id @default(uuid()) @db.Uuid
  dealId             String         @map("deal_id") @db.Uuid
  versionNumber      Int            @map("version_number")
  status             DealStatus     @default(DRAFT)
  title              String
  termsJson          Json           @map("terms_json")
  summary            String?
  sourceVersionId    String?        @map("source_version_id") @db.Uuid
  submittedAt        DateTime?      @map("submitted_at")
  lockedAt           DateTime?      @map("locked_at")
  createdByProfileId String         @map("created_by_profile_id") @db.Uuid
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  approvals          DealApproval[]
  files              DealFile[]
  createdBy          Profile        @relation("VersionCreator", fields: [createdByProfileId], references: [id])
  deal               Deal           @relation(fields: [dealId], references: [id])
  sourceVersion      DealVersion?   @relation("VersionSource", fields: [sourceVersionId], references: [id])
  derivedVersions    DealVersion[]  @relation("VersionSource")

  @@unique([dealId, versionNumber])
  @@index([dealId])
  @@index([status])
  @@map("deal_versions")
}

model DealApproval {
  id             String         @id @default(uuid()) @db.Uuid
  versionId      String         @map("version_id") @db.Uuid
  partyId        String         @map("party_id") @db.Uuid
  profileId      String         @map("profile_id") @db.Uuid
  approvalStatus ApprovalStatus @default(PENDING) @map("approval_status")
  reason         String?
  decidedAt      DateTime?      @map("decided_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  party          DealParty      @relation(fields: [partyId], references: [id])
  profile        Profile        @relation(fields: [profileId], references: [id])
  version        DealVersion    @relation(fields: [versionId], references: [id])

  @@unique([versionId, partyId])
  @@index([versionId])
  @@index([partyId])
  @@map("deal_approvals")
}

model DealFile {
  id                  String         @id @default(uuid()) @db.Uuid
  dealId              String?        @map("deal_id") @db.Uuid
  versionId           String?        @map("version_id") @db.Uuid
  kycSubmissionId     String?        @map("kyc_submission_id") @db.Uuid
  uploadedByProfileId String         @map("uploaded_by_profile_id") @db.Uuid
  storageBucket       String         @map("storage_bucket")
  storagePath         String         @map("storage_path")
  originalFileName    String         @map("original_file_name")
  contentType         String         @map("content_type")
  sizeBytes           Int            @map("size_bytes")
  fileType            FileType       @map("file_type")
  visibility          FileVisibility
  createdAt           DateTime       @default(now()) @map("created_at")
  deletedAt           DateTime?      @map("deleted_at")
  deal                Deal?          @relation(fields: [dealId], references: [id])
  kycSubmission       KycSubmission? @relation(fields: [kycSubmissionId], references: [id])
  uploadedBy          Profile        @relation(fields: [uploadedByProfileId], references: [id])
  version             DealVersion?   @relation(fields: [versionId], references: [id])

  @@index([dealId])
  @@index([versionId])
  @@index([kycSubmissionId])
  @@map("deal_files")
}

model Message {
  id              String        @id @default(uuid()) @db.Uuid
  dealId          String        @map("deal_id") @db.Uuid
  senderProfileId String        @map("sender_profile_id") @db.Uuid
  body            String
  messageStatus   MessageStatus @default(SENT) @map("message_status")
  createdAt       DateTime      @default(now()) @map("created_at")
  editedAt        DateTime?     @map("edited_at")
  deletedAt       DateTime?     @map("deleted_at")
  deal            Deal          @relation(fields: [dealId], references: [id])
  sender          Profile       @relation(fields: [senderProfileId], references: [id])

  @@index([dealId])
  @@index([createdAt])
  @@map("messages")
}

model Notification {
  id               String           @id @default(uuid()) @db.Uuid
  profileId        String           @map("profile_id") @db.Uuid
  notificationType NotificationType @map("notification_type")
  title            String
  body             String?
  payloadJson      Json             @map("payload_json")
  readAt           DateTime?        @map("read_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  profile          Profile          @relation(fields: [profileId], references: [id])

  @@index([profileId])
  @@index([readAt])
  @@map("notifications")
}

model Subscription {
  id                   String             @id @default(uuid()) @db.Uuid
  profileId            String?            @map("profile_id") @db.Uuid
  companyId            String?            @map("company_id") @db.Uuid
  planId               String?            @map("plan_id") @db.Uuid
  stripeCustomerId     String?            @map("stripe_customer_id")
  stripeSubscriptionId String?            @map("stripe_subscription_id")
  status               SubscriptionStatus @default(TRIALING)
  trialContractsUsed   Int                @default(0) @map("trial_contracts_used")
  trialContractsLimit  Int                @default(5) @map("trial_contracts_limit")
  currentPeriodEnd     DateTime?          @map("current_period_end")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  company              Company?           @relation(fields: [companyId], references: [id])
  plan                 Plan?              @relation(fields: [planId], references: [id])
  profile              Profile?           @relation(fields: [profileId], references: [id])

  @@index([profileId])
  @@index([companyId])
  @@index([planId])
  @@map("subscriptions")
}

model Plan {
  id               String         @id @default(uuid()) @db.Uuid
  code             String         @unique
  name             String
  monthlyDealLimit Int?           @map("monthly_deal_limit")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  subscriptions    Subscription[]

  @@map("plans")
}

model DealInviteLink {
  id                 String    @id @default(uuid()) @db.Uuid
  dealId             String    @map("deal_id") @db.Uuid
  token              String    @unique
  createdByProfileId String    @map("created_by_profile_id") @db.Uuid
  permissions        Json
  expiresAt          DateTime  @map("expires_at")
  maxUses            Int?      @map("max_uses")
  usedCount          Int       @default(0) @map("used_count")
  revokedAt          DateTime? @map("revoked_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  createdBy          Profile   @relation("InviteCreator", fields: [createdByProfileId], references: [id])
  deal               Deal      @relation(fields: [dealId], references: [id])

  @@index([dealId])
  @@index([token])
  @@map("deal_invite_links")
}

model AuditLog {
  id             String          @id @default(uuid()) @db.Uuid
  actorProfileId String?         @map("actor_profile_id") @db.Uuid
  actionType     AuditActionType @map("action_type")
  resourceType   String          @map("resource_type")
  resourceId     String?         @map("resource_id") @db.Uuid
  metadataJson   Json            @map("metadata_json")
  ipAddress      String?         @map("ip_address")
  userAgent      String?         @map("user_agent")
  createdAt      DateTime        @default(now()) @map("created_at")
  actor          Profile?        @relation("AuditActor", fields: [actorProfileId], references: [id])

  @@index([actionType])
  @@index([resourceType])
  @@index([resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}

model AdminAction {
  id                 String          @id @default(uuid()) @db.Uuid
  adminProfileId     String          @map("admin_profile_id") @db.Uuid
  actionType         AuditActionType @map("action_type")
  targetResourceType String          @map("target_resource_type")
  targetResourceId   String          @map("target_resource_id") @db.Uuid
  reason             String?
  metadataJson       Json            @map("metadata_json")
  createdAt          DateTime        @default(now()) @map("created_at")
  admin              Profile         @relation("AdminActor", fields: [adminProfileId], references: [id])

  @@index([adminProfileId])
  @@map("admin_actions")
}

model Report {
  id                  String       @id @default(uuid()) @db.Uuid
  reporterProfileId   String       @map("reporter_profile_id") @db.Uuid
  resourceType        String       @map("resource_type")
  resourceId          String       @map("resource_id") @db.Uuid
  status              ReportStatus @default(OPEN)
  reason              String
  resolution          String?
  reviewedByProfileId String?      @map("reviewed_by_profile_id") @db.Uuid
  reviewedAt          DateTime?    @map("reviewed_at")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")
  reporter            Profile      @relation("ReportCreator", fields: [reporterProfileId], references: [id])
  reviewedBy          Profile?     @relation("ReportReviewer", fields: [reviewedByProfileId], references: [id])

  @@index([status])
  @@map("reports")
}

enum DealStatus {
  DRAFT
  NEGOTIATION
  PENDING_APPROVAL
  APPROVED
  LOCKED
  CHANGES_REQUESTED
  REJECTED
  CANCELLED
  ARCHIVED

  @@map("deal_status")
}

enum PartyStatus {
  INVITED
  ACCEPTED
  DECLINED
  REMOVED
  EXPIRED
  REVOKED

  @@map("party_status")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  INVALIDATED

  @@map("approval_status")
}

enum KycStatus {
  NOT_STARTED
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  RESUBMISSION_REQUIRED
  REVOKED

  @@map("kyc_status")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED

  @@map("subscription_status")
}

enum NotificationType {
  DEAL_INVITATION
  APPROVAL_REQUESTED
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  FILE_UPLOADED
  KYC_UPDATED
  SUBSCRIPTION_UPDATED
  ADMIN_ACTION

  @@map("notification_type")
}

enum FileType {
  AVATAR
  DEAL_ATTACHMENT
  KYC_DOCUMENT
  GENERATED_CONTRACT

  @@map("file_type")
}

enum FileVisibility {
  PRIVATE
  PARTICIPANT_PRIVATE
  ADMIN_PRIVATE

  @@map("file_visibility")
}

enum CompanyMemberRole {
  OWNER
  MANAGER
  MEMBER
  VIEWER

  @@map("company_member_role")
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  SUPPORT_REVIEWER
  FINANCE_REVIEWER

  @@map("admin_role")
}

enum AuditActionType {
  ACCOUNT_CREATED
  KYC_SUBMITTED
  KYC_APPROVED
  KYC_REJECTED
  KYC_REVOKED
  KYC_RECHECK
  KYC_RESUBMISSION_REQUESTED
  DEAL_CREATED
  DEAL_UPDATED
  DEAL_DELETED
  DEAL_VERSION_CREATED
  DEAL_SHARED
  DEAL_INVITE_ACCEPTED
  DEAL_INVITE_REVOKED
  PARTY_INVITED
  PARTY_ACCEPTED
  PARTY_DECLINED
  VERSION_CREATED
  VERSION_SUBMITTED
  VERSION_APPROVED
  VERSION_REJECTED
  CHANGES_REQUESTED
  VERSION_LOCKED
  FILE_UPLOADED
  MESSAGE_CREATED
  SUBSCRIPTION_EVENT
  ADMIN_ACTION

  @@map("audit_action_type")
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED

  @@map("report_status")
}

enum MessageStatus {
  SENT
  EDITED
  DELETED
  HIDDEN

  @@map("message_status")
}
model Contract {
  id              String            @id @default(uuid()) @db.Uuid
  title           String
  description     String?
  contractType    String?           @map("contract_type")
  content         String?
  status          ContractStatus    @default(DRAFT)
  createdByProfileId String?        @map("created_by_profile_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  parties         ContractParty[]
  sendLogs        ContractSendLog[]

  @@map("contracts")
}

model ContractParty {
  id           String   @id @default(uuid()) @db.Uuid
  contractId   String   @map("contract_id") @db.Uuid
  role         String   // ex: "CLIENT", "PRESTATAIRE"
  fullName     String   @map("full_name")
  functionRole String?  @map("function_role") // ex: "Cliente", "Prestataire"
  address      String?
  email        String?
  signedAt     DateTime? @map("signed_at")
  signatureImage String? @map("signature_image")
  createdAt    DateTime @default(now()) @map("created_at")
  contract     Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@map("contract_parties")
}

model ContractSendLog {
  id          String   @id @default(uuid()) @db.Uuid
  contractId  String   @map("contract_id") @db.Uuid
  sentToEmail String   @map("sent_to_email")
  sentAt      DateTime @default(now()) @map("sent_at")
  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@map("contract_send_logs")
}

enum ContractStatus {
  DRAFT
  SENT
  SIGNED
  CANCELLED

  @@map("contract_status")
}
